// 스키마 소유(plan §3): Room·RoomMember·Participant 기본 필드는 BE-S1-1이 만든다.
// Room.revision은 BE-F7, IdempotencyRecord는 BE-F6, Transaction·nextTxnSeq·lastTxnCreatedAt은 BE-S2-1(모두 추가됨), StreamLease는 BE-S5-6이 추가한다.
// CHECK 제약과 부분 인덱스는 Prisma가 표현하지 못하므로 SQL 마이그레이션(prisma/migrations/*/migration.sql)에 직접 쓴다(PD-2).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 방. name·unit·inviteCode는 생성 뒤 변하지 않는다(S1 §2.2 I6).
model Room {
  id               String    @id
  name             String
  unit             String
  /// IN_PROGRESS | ENDED (CHECK)
  status           String    @default("IN_PROGRESS")
  inviteCode       String    @unique
  /// 방 변경 번호(BE-F7). 변경이 실제로 있을 때만 방 잠금 안에서 1 증가한다
  revision         Int       @default(0)
  /// 다음 거래 순번(BE-S2-1). 거래 생성 때 방 잠금 안에서 1 증가한다
  nextTxnSeq       Int       @default(1)
  /// 마지막 거래 생성 시각. createdAt = greatest(clock_timestamp(), lastTxnCreatedAt)로 비감소를 보장한다
  lastTxnCreatedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  members            RoomMember[]
  participants       Participant[]
  transactions       Transaction[]
  idempotencyRecords IdempotencyRecord[]
}

/// 익명 접속 주체. 신원 키는 SHA-256 해시(소문자 hex)로만 저장한다(PD-14).
model RoomMember {
  id              String   @id
  roomId          String
  /// NFC 정규화한 닉네임
  nickname        String
  /// 닉네임 비교 키(S1 §3.2): A-Z만 소문자
  nicknameKey     String
  isHost          Boolean
  identityKeyHash String
  createdAt       DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  room               Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  authored           Transaction[]       @relation("TransactionAuthor")
  deletedTxns        Transaction[]       @relation("TransactionDeletedBy")
  idempotencyRecords IdempotencyRecord[]

  @@unique([roomId, identityKeyHash])
  @@unique([roomId, nicknameKey])
}

/// 게임 참여자. RoomMember와 잇는 필드·관계는 없다(S1 §2.2 I2).
model Participant {
  id          String   @id
  roomId      String
  nickname    String
  nicknameKey String
  /// ACTIVE | INACTIVE (CHECK)
  status      String   @default("ACTIVE")
  /// 방 안에서 유일한 양의 정수, 한 번 부여되면 바뀌지 않는다
  order       Int
  createdAt   DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  room     Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  paid     Transaction[] @relation("TransactionPayer")
  received Transaction[] @relation("TransactionPayee")

  @@unique([roomId, order])
  @@unique([roomId, nicknameKey])
}

/// 거래(BE-S2-1). 삭제는 행을 지우지 않고 deletedAt을 채운다(S2 §6.4).
model Transaction {
  id             String    @id
  roomId         String
  seq            Int
  payerId        String
  payeeId        String
  /// 1..999,999,999 (CHECK). BIGINT로 저장·합산한다(NFR-009)
  amount         BigInt
  reason         String?
  round          String?
  authorId       String
  originalAmount BigInt
  originalReason String?
  originalRound  String?
  createdAt      DateTime  @db.Timestamptz(3)
  updatedAt      DateTime  @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
  deletedById    String?

  room      Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payer     Participant @relation("TransactionPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee     Participant @relation("TransactionPayee", fields: [payeeId], references: [id], onDelete: Restrict)
  author    RoomMember  @relation("TransactionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy RoomMember? @relation("TransactionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@unique([roomId, seq])
}

/// 멱등 기록(BE-F6, S2 §5). (방, RoomMember, 키) 유일.
model IdempotencyRecord {
  id             String   @id
  roomId         String
  memberId       String
  key            String
  /// CREATE | UPDATE | DELETE | END (CHECK)
  operation      String
  /// 연산 종류·대상 ID·본문 정규형의 SHA-256(hex)
  fingerprint    String
  firstAttemptAt DateTime @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  statusCode     Int
  responseBody   Json
  createdAt      DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  room   Room       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  member RoomMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([roomId, memberId, key])
  @@index([expiresAt])
}
