// 스키마 소유(plan §3): Room·Participant 기본 필드는 BE-S1-1, v2.0.0 개정(RoomMember 삭제, Participant 신원·방장, ClaimRequest, RevokedIdentity)은 BE-M1이 만든다.
// Room.revision은 BE-F7, IdempotencyRecord는 BE-F6, Transaction·nextTxnSeq·lastTxnCreatedAt은 BE-S2-1(모두 추가됨), StreamLease(추가됨)는 BE-S5-6이 소유한다.
// CHECK 제약과 부분 인덱스는 Prisma가 표현하지 못하므로 SQL 마이그레이션(prisma/migrations/*/migration.sql)에 직접 쓴다(PD-2).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 방. name·unit·inviteCode는 생성 뒤 변하지 않는다(S1 §2.2 I6).
model Room {
  id               String    @id
  name             String
  unit             String
  /// IN_PROGRESS | ENDED (CHECK)
  status           String    @default("IN_PROGRESS")
  inviteCode       String    @unique
  /// 방 변경 번호(BE-F7). 변경이 실제로 있을 때만 방 잠금 안에서 1 증가한다
  revision         Int       @default(0)
  /// 다음 거래 순번(BE-S2-1). 거래 생성 때 방 잠금 안에서 1 증가한다
  nextTxnSeq       Int       @default(1)
  /// 마지막 거래 생성 시각. createdAt = greatest(clock_timestamp(), lastTxnCreatedAt)로 비감소를 보장한다
  lastTxnCreatedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  participants       Participant[]
  transactions       Transaction[]
  idempotencyRecords IdempotencyRecord[]
  streamLeases       StreamLease[]
  claimRequests      ClaimRequest[]
  revokedIdentities  RevokedIdentity[]
}

/// 방의 유일한 사람 단위(S1 §2.1, OQ-041). 신원 키는 SHA-256 해시(소문자 hex)로만 저장하고 응답에 싣지 않는다(PD-14, S1-C6).
model Participant {
  id              String   @id
  roomId          String
  nickname        String
  nicknameKey     String
  /// ACTIVE | INACTIVE (CHECK). 방장은 항상 ACTIVE(CHECK)
  status          String   @default("ACTIVE")
  /// 방 안에서 유일한 양의 정수, 한 번 부여되면 바뀌지 않는다
  order           Int
  /// 방을 만든 참여자만 true. 방마다 최대 하나(부분 유일 인덱스), 생성 뒤 바뀌지 않는다
  isHost          Boolean  @default(false)
  /// 연결된 신원 키 해시(직접 추가한 참여자는 null). (roomId, identityKeyHash)는 부분 유일 인덱스(PD-21)
  identityKeyHash String?
  createdAt       DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  room               Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  paid               Transaction[]       @relation("TransactionPayer")
  received           Transaction[]       @relation("TransactionPayee")
  authored           Transaction[]       @relation("TransactionAuthor")
  deletedTxns        Transaction[]       @relation("TransactionDeletedBy")
  idempotencyRecords IdempotencyRecord[]
  streamLeases       StreamLease[]
  claims             ClaimRequest[]      @relation("ClaimTarget")
  resolvedClaims     ClaimRequest[]      @relation("ClaimResolvedBy")
  revokedIdentities  RevokedIdentity[]

  @@unique([roomId, order])
  @@unique([roomId, nicknameKey])
}

/// 이어받기 요청(S1 §2.1, §5.5). 요청 키는 해시로만 보관하고 응답에 싣지 않는다. 닉네임은 대상 참여자에서 읽는다.
/// (roomId, requesterKeyHash)의 PENDING은 최대 하나(부분 유일 인덱스), 상태·사유·처리자 조합은 CHECK.
model ClaimRequest {
  id               String    @id
  roomId           String
  participantId    String
  requesterKeyHash String
  /// PENDING | APPROVED | REJECTED | CANCELED (CHECK)
  status           String    @default("PENDING")
  /// HOST_REJECTED | TARGET_CLAIMED | REQUESTER_LINKED, REJECTED일 때만 (CHECK)
  rejectReason     String?
  createdAt        DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  resolvedAt       DateTime? @db.Timestamptz(3)
  /// 처리한 방장의 참여자 ID(승인·거절). 취소는 null
  resolvedById     String?

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  participant Participant  @relation("ClaimTarget", fields: [participantId], references: [id], onDelete: Restrict)
  resolvedBy  Participant? @relation("ClaimResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([roomId, requesterKeyHash, createdAt(sort: Desc), id(sort: Desc)], map: "ClaimRequest_roomId_requesterKeyHash_createdAt_idx")
}

/// 이어받기 승인으로 참여자에서 끊긴 이전 신원 키 해시(S1-C4). 그 키의 이 방 요청은 401 IDENTITY_REVOKED다.
model RevokedIdentity {
  roomId        String
  keyHash       String
  participantId String
  revokedAt     DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@id([roomId, keyHash])
}

/// 거래(BE-S2-1). 삭제는 행을 지우지 않고 deletedAt을 채운다(S2 §6.4).
model Transaction {
  id             String    @id
  roomId         String
  seq            Int
  payerId        String
  payeeId        String
  /// 1..999,999,999 (CHECK). BIGINT로 저장·합산한다(NFR-009)
  amount         BigInt
  reason         String?
  round          String?
  authorId       String
  originalAmount BigInt
  originalReason String?
  originalRound  String?
  createdAt      DateTime  @db.Timestamptz(3)
  updatedAt      DateTime  @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
  deletedById    String?

  room      Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payer     Participant  @relation("TransactionPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee     Participant  @relation("TransactionPayee", fields: [payeeId], references: [id], onDelete: Restrict)
  author    Participant  @relation("TransactionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedBy Participant? @relation("TransactionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@unique([roomId, seq])
}

/// 멱등 기록(BE-F6, S2 §5). (방, 참여자, 키) 유일(PD-7).
model IdempotencyRecord {
  id             String   @id
  roomId         String
  participantId  String
  key            String
  /// CREATE | UPDATE | DELETE | END (CHECK)
  operation      String
  /// 연산 종류·대상 ID·본문 정규형의 SHA-256(hex)
  fingerprint    String
  firstAttemptAt DateTime @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  statusCode     Int
  responseBody   Json
  createdAt      DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([roomId, participantId, key])
  @@index([expiresAt])
}

/// SSE 연결 임대(BE-S5-6). 만료 T=15초, 인스턴스가 T/3마다 일괄 갱신한다.
model StreamLease {
  id            String   @id
  roomId        String
  participantId String
  instanceId    String
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([roomId, participantId])
  @@index([instanceId])
  @@index([expiresAt])
}
