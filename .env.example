# 복사해서 .env로 쓴다. .env는 Git에 올리지 않는다.
# development | test | production (필수, 기본값 없음)
NODE_ENV=development
PORT=3001
# 쉼표로 구분한 허용 출처. development에서만 생략 가능(기본 http://localhost:3000)
CORS_ORIGINS=http://localhost:3000
# BE-F2에서 사용한다. 값은 아래 POSTGRES_*와 맞춘다
DATABASE_URL=postgresql://ddallang:change-me@localhost:5432/ddallang
# docker compose 전용
POSTGRES_USER=ddallang
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ddallang
