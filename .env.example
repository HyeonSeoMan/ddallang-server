# 복사해서 .env로 쓴다. .env는 Git에 올리지 않는다.
# development | test | production (필수, 기본값 없음)
NODE_ENV=development
PORT=3001
# 쉼표로 구분한 허용 출처(필수, 모든 환경)
CORS_ORIGINS=http://localhost:3000
# BE-F2에서 사용한다. 값은 아래 POSTGRES_*와 맞춘다
DATABASE_URL=postgresql://ddallang:change-me@localhost:5432/ddallang
# DB 시간 제한(ms). DB_LOCK_TIMEOUT_MS < DB_STATEMENT_TIMEOUT_MS < REQUEST_TIMEOUT_MS < 3600000 이어야 한다
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
# 인스턴스당 연결 풀 상한(인스턴스 2개 이상, 같은 PostgreSQL 공유 가정)
DB_POOL_MAX=10
# docker compose 전용
POSTGRES_USER=ddallang
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ddallang
